# EVENTTICKETINGSYSTEM backend settings. Copy this file to ".env" (same folder) and edit the values.
# Never commit .env with real passwords.

# MySQL connection (the database is created automatically if it does not exist)
DB_URL=jdbc:mysql://localhost:3306/event_ticketing_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
FLYWAY_BASELINE_ON_MIGRATE=false

# JWT (use 32+ random characters)
JWT_SECRET=change-me-to-a-long-random-secret-0123456789abcdef
JWT_EXPIRATION=86400000

# Browsers allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional AI chat assistant (leave empty to disable). Free key: https://console.groq.com/keys
GROQ_API_KEY=
