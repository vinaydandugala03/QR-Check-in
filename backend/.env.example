# EVENTTICKETINGSYSTEM backend settings. Copy this file to ".env" (same folder) and edit the values.
# Never commit .env with real passwords.

# Aiven MySQL. Keep credentials in the local, git-ignored .env file.
DB_URL=jdbc:mysql://mysql-2245147-vinaydandugala-7298.g.aivencloud.com:26517/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=<SET_FROM_AIVEN_CONSOLE>
FLYWAY_BASELINE_ON_MIGRATE=false

# JWT (use 32+ random characters)
JWT_SECRET=change-me-to-a-long-random-secret-0123456789abcdef
JWT_EXPIRATION=86400000

# Browsers allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional AI chat assistant (leave empty to disable). Free key: https://console.groq.com/keys
GROQ_API_KEY=
